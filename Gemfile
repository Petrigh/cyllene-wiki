source "https://rubygems.org"

# Pinned to the version GitHub Pages actually builds with.
# jekyll-remote-theme ships as a dependency of this gem -- declaring it
# separately un-pins it and drags github-pages back to an ancient release.
gem "github-pages", "~> 232", group: :jekyll_plugins

# Not in Ruby's stdlib since 3.0; `jekyll serve` needs it.
gem "webrick", "~> 1.8"
